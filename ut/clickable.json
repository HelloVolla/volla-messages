{
  "clickable_minimum_required": "8.10.0",
  "build": "bash ${ROOT}/build.sh",
  "postbuild": "bash ${ROOT}/postbuild.sh",
  "framework": "ubuntu-touch-24.04-2.x",
  "builder": "custom",
  "skip_review": true,
  "always_clean": true,
  "install_lib": [
    "/usr/lib/${ARCH_TRIPLET}/gtk-3.0/3.0.0/immodules/im-maliit.so",
    "libenchant-2.so.2*",
    "libharfbuzz-icu.so.0*",
    "libhyphen.so.0*",
    "libjavascriptcoregtk-4.1.so.0*",
    "libmaliit-glib.so.2*",
    "libmanette-0.2.so.0*",
    "libwebkit2gtk-4.1.so.0*"
  ],
  "install_root_data": [
    "${BUILD_DIR}/usr/bin/volla_messages",
    "manifest.json",
    "assets/volla-messages-icon.png",
    "volla-messages.desktop",
    "volla-messages.apparmor"
  ],
  "install_data": {
    "/usr/lib/${ARCH_TRIPLET}/webkit2gtk-4.1/WebKit*Process": "lib/${ARCH_TRIPLET}/webkit2gtk-4.1",
    "/usr/lib/${ARCH_TRIPLET}/webkit2gtk-4.1/injected-bundle": "lib/${ARCH_TRIPLET}/webkit2gtk-4.1"
  },
  "dependencies_host": [
    "click",
    "gcc",
    "libc6-dev"
  ],
  "dependencies_target": [
    "libwebkit2gtk-4.1-0",
    "maliit-inputcontext-gtk3"
  ]
}
