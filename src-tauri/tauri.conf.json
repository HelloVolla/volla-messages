{
  "productName": "Volla Messages",
  "identifier": "com.volla.messages.bundled",
  "version": "1.0.3",
  "build": {
    "beforeBuildCommand": "npm run build -w ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/colon/32x32.png",
      "icons/colon/128x128.png",
      "icons/colon/128x128@2x.png",
      "icons/colon/icon.icns",
      "icons/colon/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "app": {
    "windows": [
      {
        "width": 360,
        "height": 720,
        "decorations": false,
        "resizable": true,
        "center": true,
        "url": "splashscreen.html",
        "label": "splashscreen"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFMEQ0NzRDODc0RTlDMEYKUldRUG5FNkhURWNOSHFwc0RhaDl5ajBSQ091dmhkTjhjSWp6bklvV0JoMHkvNmZ1R3VPOE5DZ3gK",
      "endpoints": [
        "https://github.com/HelloVolla/volla-messages/releases/latest/download/latest.json"
      ]
    }
  }
}
